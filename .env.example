# =============================================================================
# Amadeus AI - Environment Configuration Template
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT (development / staging / production)
# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# STAGING (Tighter rate limits, debug often true)
# ENV=staging
# DEBUG=true
# LOG_LEVEL=INFO

# PRODUCTION (No debug, secure config)
# ENV=production
# DEBUG=false
# LOG_LEVEL=WARNING

# -----------------------------------------------------------------------------
# SECURITY (Required in production)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# API KEYS — LLM Providers
# -----------------------------------------------------------------------------
# PRIMARY: Groq (Free: 14,400 req/day) — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# SECONDARY: Gemini (Free tier) — https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# EMERGENCY: OpenAI (Paid — only for high-complexity queries)
# OPENAI_API_KEY=your_openai_api_key_here  # DISABLED - Costs money

# -----------------------------------------------------------------------------
# API KEYS — Search
# -----------------------------------------------------------------------------
# Tavily (Free: 1,000 req/month, paid after) — https://tavily.com
TAVILY_API_KEY=your_tavily_key_here

# Weather and News (optional)
WEATHER_API_KEY=your_weather_api_key_here
NEWS_API_KEY=your_news_api_key_here

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# Default: SQLite for development
DATABASE_URL=sqlite:///./data/amadeus.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/amadeus

# Redis (for caching + rate limiting)
REDIS_URL=redis://localhost:6379/0

# Connection Pool Settings (for non-SQLite databases)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false



# -----------------------------------------------------------------------------
# ASSISTANT IDENTITY
# -----------------------------------------------------------------------------
ASSISTANT_NAME=Amadeus
ASSISTANT_VERSION=2.0.0
ASSISTANT_PERSONALITY=helpful, concise, and friendly
DEFAULT_LOCATION=India
TIMEZONE=Asia/Kolkata

# -----------------------------------------------------------------------------
# CONVERSATION SETTINGS
# -----------------------------------------------------------------------------
CONVERSATION_MAX_HISTORY=20
CONVERSATION_MAX_TOKENS_ESTIMATE=4000
CONTEXT_SUMMARY_LENGTH=500

# -----------------------------------------------------------------------------
# TOOL EXECUTION
# -----------------------------------------------------------------------------
TOOL_MAX_RETRIES=3
TOOL_TIMEOUT=60

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Rate Limiting
# Note: For staging, it is recommended to set tighter limits to prevent testing abuse
# RATE_LIMIT_REQUESTS=30 (staging)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# SYSTEM MONITORING THRESHOLDS
# -----------------------------------------------------------------------------
CPU_WARNING_THRESHOLD=80
CPU_CRITICAL_THRESHOLD=95
MEMORY_WARNING_THRESHOLD=80
MEMORY_CRITICAL_THRESHOLD=95
DISK_WARNING_THRESHOLD=80
DISK_CRITICAL_THRESHOLD=95
BATTERY_LOW_THRESHOLD=20
BATTERY_CRITICAL_THRESHOLD=10

# -----------------------------------------------------------------------------
# FILE OPERATIONS
# -----------------------------------------------------------------------------
FILE_SEARCH_MAX_RESULTS=10
FILE_READ_MAX_CHARS=5000
APP_LAUNCH_TIMEOUT=15

# -----------------------------------------------------------------------------
# PRODUCTIVITY FEATURES
# -----------------------------------------------------------------------------
# Reminders
REMINDER_CHECK_INTERVAL=30
REMINDER_LOOP_STARTUP_TIMEOUT=5.0
REMINDER_LOOP_STOP_TIMEOUT=5.0

# Pomodoro
POMODORO_WORK_DURATION=25
POMODORO_SHORT_BREAK=5
POMODORO_LONG_BREAK=15
POMODORO_CYCLES_BEFORE_LONG_BREAK=4

# Calendar
CALENDAR_DEFAULT_EVENT_DURATION=60
CALENDAR_REMINDER_BEFORE_MINUTES=15
CALENDAR_MAX_EVENTS_DISPLAY=10
CALENDAR_DAYS_AHEAD_DEFAULT=7

# -----------------------------------------------------------------------------
# DISPLAY LIMITS
# -----------------------------------------------------------------------------
DISPLAY_PROCESSES_COUNT=10

DISPLAY_TEMPERATURE_SENSORS_LIMIT=3
DISPLAY_ALERTS_LIMIT=5

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
SENTRY_DSN=

# -----------------------------------------------------------------------------
# SKIP VALIDATION (for testing)
# -----------------------------------------------------------------------------
SKIP_CONFIG_VALIDATION=false

# -----------------------------------------------------------------------------
# MESSAGING: TELEGRAM
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public webhook URL where Telegram sends updates (must be HTTPS, e.g. via Railway/ngrok)
# e.g. https://your-domain.com/api/v1/messaging/telegram
TELEGRAM_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# MESSAGING: WHATSAPP (Meta Cloud API)
# -----------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# PROACTIVE MESSAGING (Master Users)
# -----------------------------------------------------------------------------
# ID for proactive notifications via Telegram (integer/string ID of the user chat)
MASTER_TELEGRAM_CHAT_ID=
# Phone number for proactive notifications via WhatsApp
MASTER_WHATSAPP_NUMBER=
# Interval in minutes for proactive checking
PROACTIVE_CHECK_INTERVAL_MINUTES=30

# -----------------------------------------------------------------------------
# EMAIL (IMAP / SMTP)
# -----------------------------------------------------------------------------
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# -----------------------------------------------------------------------------
# MEMORY / SUMMARIZATION
# -----------------------------------------------------------------------------
MEMORY_SUMMARIZATION_THRESHOLD=10

# Vector / Long-term Semantic Memory (Qdrant)
MEMORY_ENABLED=true
MEMORY_PERSIST_DIR=./data/vector_db
MEMORY_COLLECTION_NAME=amadeus_memory
# Gemini embedding model used for semantic memory (requires GEMINI_API_KEY)
MEMORY_EMBED_MODEL=models/embedding-001

# -----------------------------------------------------------------------------
# MODEL DIRECTORY & AUTO-DOWNLOAD
# All local models live here (default: <project>/Model/).
# Set MODEL_DOWNLOAD_ENABLED=true to auto-fetch missing models on first run.
# -----------------------------------------------------------------------------
# MODEL_DIR=/absolute/path/to/Amadeus-AI/Model  # default: <project>/Model/
MODEL_DOWNLOAD_ENABLED=true

# Embedding model (sentence-transformers compatible HF model ID)
# The model is downloaded once to MODEL_DIR/embed/<model-name>/
EMBED_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBED_MODEL_NAME=sentence-transformers/all-mpnet-base-v2   # larger, better quality
# EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5                   # fastest, good quality

# Local LLM (GGUF via llama-cpp-python)
# Option A — point directly at an already-downloaded .gguf file
# SLM_MODEL_PATH=/absolute/path/to/some-model.gguf

# Option B — let Amadeus auto-download from HuggingFace into Model/
# Pick any GGUF repo from https://huggingface.co/models?library=gguf
SLM_MODEL_REPO_ID=bartowski/Llama-3.2-1B-Instruct-GGUF
SLM_MODEL_FILENAME=Llama-3.2-1B-Instruct-Q4_K_M.gguf
# SLM_MODEL_REPO_ID=bartowski/Llama-3.2-3B-Instruct-GGUF
# SLM_MODEL_FILENAME=Llama-3.2-3B-Instruct-Q4_K_M.gguf
# SLM_MODEL_REPO_ID=bartowski/Meta-Llama-3.1-8B-Instruct-GGUF
# SLM_MODEL_FILENAME=Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf

# LLM inference settings
SLM_THREADS=4
SLM_CTX_SIZE=4096
LOCAL_ONLY_MODE=true
