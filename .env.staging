# Amadeus-AI Staging Environment Variables
ENV=staging
DEBUG=true
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=postgresql://amadeus_staging:staging_pass@postgres:5432/amadeus_staging_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# API Keys
# GEMINI_API_KEY=your_staging_key_here
# WEATHER_API_KEY=your_staging_key_here

# Services
VOICE_ENABLED=false
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60
