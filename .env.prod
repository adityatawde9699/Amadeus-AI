# Amadeus-AI Production Environment Variables
ENV=production
DEBUG=false
LOG_LEVEL=WARNING

# Database
DATABASE_URL=postgresql://amadeus_prod:prod_pass@postgres:5432/amadeus_prod_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=50

# API Keys
# GEMINI_API_KEY=your_prod_key_here
# WEATHER_API_KEY=your_prod_key_here

# Observability
# SENTRY_DSN=your_sentry_dsn_here

# Services
VOICE_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
